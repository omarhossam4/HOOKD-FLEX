# --- Site ---
NEXT_PUBLIC_SITE_URL=https://hookd.agency

# --- Contact (placeholders shown on the site until these are set) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Contact form -> Google Sheet ---
# The Web App URL from your Google Apps Script deployment. See README.md
# "Connect the contact form to a Google Sheet" for setup steps.
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Lead email notifications (optional) ---
# Sign up at https://resend.com, verify a sending domain, then set:
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_NOTIFICATION_FROM=

# --- Analytics (optional — each loads only when its ID is set) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
